# Local mode works without Azure. Export these to enable Foundry/OpenAI.
FOLEYGRAPH_DATA_DIR=.data
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=foleygraph-director
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=foleygraph-transcribe
# Optional API key for local use. Deployment uses managed identity instead.
AZURE_OPENAI_API_KEY=
# Leave empty to use SQLite locally. Deployment uses Azure Table Storage.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_TABLE=foleygraph
# Required on Azure; generated automatically by scripts/deploy.py.
WORKSPACE_SECRET=
